# Copy to .env, fill in, then load before running anything:
#   set -a; source .env; set +a

# --- LTX-2.5 checkpoints (Hugging Face: Lightricks/LTX-2.5) ---
# ltx-2.5-22b-distilled-transformer-bf16.safetensors
LTX25_TRANSFORMER="PATH TO CHECKPOINT"
# gemma4-12b-with-proj-ltx-2.5-bf16.safetensors
LTX25_TEXT_ENCODER="PATH TO CHECKPOINT"
# ltx-2.5-video-vae-conv-bf16.safetensors  (the "-conv-" variant)
LTX25_VIDEO_VAE="PATH TO CHECKPOINT"
# ltx-2.5-audio-vae-bf16.safetensors
LTX25_AUDIO_VAE="PATH TO CHECKPOINT"
# ltx-2.5-latent-spatial-upscaler-x2-bf16-1.0.safetensors
LTX25_SPATIAL_UPSAMPLER="PATH TO CHECKPOINT"

# --- ProPainter checkpoints ---
# folder containing ProPainter.pth, raft-things.pth, recurrent_flow_completion.pth
PROPAINTER_WEIGHTS_DIR="PATH TO CHECKPOINT"

# --- python of the ProPainter environment (Python 3.8) ---
PROPAINTER_PYTHON="PATH TO PROPAINTER PYTHON"

# --- captioning ---
# Paste your API key here:
OPENAI_API_KEY=""
# Name of a vision-capable chat model:
HUD_CAPTION_MODEL=""
