# Copy to .env, fill in, then load before running anything:
#   set -a; source .env; set +a
# Every script also accepts these as command-line flags instead (--transformer-path, ...).

# --- LTX-2.5 base model (Hugging Face: Lightricks/LTX-2.5) ---
# diffusion_models/ltx-2.5-22b-distilled-transformer-bf16.safetensors
GAMESCRUB_TRANSFORMER="PATH TO CHECKPOINT"
# text_encoders/gemma4-12b-with-proj-ltx-2.5-bf16.safetensors
GAMESCRUB_TEXT_ENCODER="PATH TO CHECKPOINT"
# vae/ltx-2.5-video-vae-bf16.safetensors
GAMESCRUB_VIDEO_VAE="PATH TO CHECKPOINT"
# vae/ltx-2.5-audio-vae-bf16.safetensors
GAMESCRUB_AUDIO_VAE="PATH TO CHECKPOINT"
# latent_upscale_models/ltx-2.5-latent-spatial-upscaler-x2-bf16-1.0.safetensors
GAMESCRUB_SPATIAL_UPSAMPLER="PATH TO CHECKPOINT"

# --- GameScrub LoRA (Hugging Face: mohammadareebqazi/GameScrub) ---
# gamescrub_lora.safetensors
GAMESCRUB_LORA="PATH TO CHECKPOINT"

# --- optional ---
# Lets PyTorch reuse fragmented GPU memory; recommended for long videos.
PYTORCH_CUDA_ALLOC_CONF="expandable_segments:True"
